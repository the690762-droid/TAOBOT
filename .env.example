# Telegram: tạo bot qua @BotFather rồi dán token vào đây (không commit file .env)
TELEGRAM_BOT_TOKEN=
# User ID Telegram được phép điều khiển (số, ngăn cách bằng dấu phẩy). Lấy từ @userinfobot
TELEGRAM_ALLOWED_USER_IDS=
# false = chạy thật (agent CLI và Telegram thật); true = mock để thử nghiệm
MOCK_MODE=false
# Cổng API cho giao diện desktop
RYAN_API_PORT=8765
